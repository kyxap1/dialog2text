<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: ./svc.sh install substitutes REPO_PATH and copies this into
  ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pro.kyxap.whisper-mlx.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/worker.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>
  <!-- launchd's default PATH has no Homebrew, where ffmpeg/ffprobe live. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPO_PATH/jobs/worker.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/jobs/worker.log</string>
</dict>
</plist>
