# Copy to bot/.env and fill in. Compose reads this file.

TELEGRAM_BOT_TOKEN=      # @BotFather -> /newbot
ALLOWED_USER_IDS=        # comma/space-separated numeric ids (@userinfobot); only these are served
# my.telegram.org -> API development tools. Telethon needs these even in
# bot-token mode; MTProto lifts the download limit to 2 GB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local model, run by the host worker with mlx-lm on the Metal GPU. The weights
# are loaded per summary (~10 s) and nothing holds RAM in between; they are
# downloaded on first use. ~16 GB for -4bit, ~28 GB for -8bit.
LLM_PROVIDER=local
LLM_MODEL=mlx-community/Qwen3.8-27B-4bit    # HF repo id (downloaded into models/), or a host path

# Grok (or any OpenAI-compatible API) instead:
# LLM_PROVIDER=grok
# LLM_API_KEY=
# LLM_MODEL=grok-4                                # see docs.x.ai/docs/models

# Optional:
# LLM_STRIP_REASONING=true    # drop a reasoning model's <think> block from the summary
# LLM_BASE_URL=               # override the remote provider's endpoint
