# Copy to bot/.env and fill in. Compose reads this file.

# From @BotFather (/newbot). Looks like 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (ask @userinfobot). Only this id is served.
ADMIN_USER_ID=

# From https://my.telegram.org -> API development tools. Needed by the local
# telegram-bot-api server so it can download files larger than 20 MB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# LLM. Grok (xAI) is the only provider implemented.
LLM_PROVIDER=grok
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Confirm the current model name in the xAI docs (https://docs.x.ai/docs/models).
LLM_MODEL=grok-beta
